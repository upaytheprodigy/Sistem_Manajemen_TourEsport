<VBox xmlns="http://javafx.com/javafx"
      xmlns:fx="http://javafx.com/fxml"
      fx:controller="com.myteam.tournament.app.controller.InputScoreController"
      alignment="CENTER" spacing="20" stylesheets="@../style/style.css">

    <Label text="INPUT SKOR" styleClass="big-title"/>

    <VBox spacing="10">
        <Label fx:id="lblMatch" text="Match: "/>

        <HBox spacing="15" alignment="CENTER">
            <TextField fx:id="txtScoreA" promptText="Skor Tim A" styleClass="input-field"/>
            <Label text="vs" style="-fx-text-fill: #fff; -fx-font-size: 20;"/>
            <TextField fx:id="txtScoreB" promptText="Skor Tim B" styleClass="input-field"/>
        </HBox>
    </VBox>

    <HBox spacing="20">
        <Button fx:id="btnSubmit" text="SUBMIT" onAction="#onSubmit"/>
        <Button text="KEMBALI" onAction="#onBack"/>
    </HBox>

</VBox>
